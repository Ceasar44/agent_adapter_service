APP_ENV=development
APP_CONFIG_FILE=configs/app.yaml
DATABASE_ENABLED=false
DATABASE_CREATE_SCHEMA=false
# AG-UI requires database, Parlant, BFF keys and the selected provider's API key.
# Run python -m scripts.migrate_bff_nonce before enabling it in production.
AGUI_ENABLED=false
AGUI_TENANT_ID=tenant
AGUI_STORE_ID=store
BFF_ISSUER=storefront
BFF_AUDIENCE=adapter
# JSON kid -> standard base64 of >=32 random bytes; provision via environment/secret storage.
# Match Next.js AGENT_BFF_KEY_ID / AGENT_BFF_SIGNING_SECRET. Never use Saleor tokens.
# BFF_KEYS={"active":"<base64-key>","previous":"<previous-base64-key>"}
BFF_MAX_AGE_SECONDS=60
BFF_CLOCK_SKEW_SECONDS=5
DATABASE_URL=sqlite+aiosqlite:///./adapter.db
SALEOR_ENABLED=false
SALEOR_API_URL=http://localhost:8001/graphql/
SALEOR_SERVICE_TOKEN=
RAG_ENABLED=false
RAG_CONFIG_FILE=configs/mcp/rag.yaml
RAG_MCP_URL=http://localhost:8002/mcp
RAG_MCP_TOKEN=
PARLANT_ENABLED=false
PARLANT_CONFIG_DIR=configs/agents/customer_service
PARLANT_PORT=8800
PARLANT_TOOL_SERVICE_PORT=8818
PARLANT_STARTUP_TIMEOUT_SECONDS=300
OPENAI_API_KEY=
# Select qwen to use DASHSCOPE_API_KEY instead of OPENAI_API_KEY.
NLP_PROVIDER=openai
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# domestic: Beijing; international: Singapore. Match your API key's region.
QWEN_REGION=domestic
# Optional override for a compatible endpoint, including /compatible-mode/v1.
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ADMIN_MCP_ENABLED=false
ADMIN_MCP_CONFIG_FILE=configs/mcp/admin_server.yaml
# Set ADMIN_MCP_OPERATOR_TOKEN in the process environment / secret manager (not this file).
